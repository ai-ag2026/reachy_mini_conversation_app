# Realtime backend to use: "huggingface", "openai", "gemini", or "local".
# Defaults to "huggingface" when unset. Use "local" to route the brain to your own
# self-hosted OpenAI-compatible agent with local STT/TTS (see the Local Agent block below).
# BACKEND_PROVIDER="huggingface"
# Optional model override for OpenAI Realtime or Gemini Live.
# Hugging Face uses the server's model selection and ignores MODEL_NAME.
# MODEL_NAME="gpt-realtime-2"

# Optional realtime input transcription language.
# Defaults to "en". Set to a backend-supported code such as "zh" for Chinese.
# REALTIME_TRANSCRIPTION_LANGUAGE="en"

# Set up your API key according to your backend
OPENAI_API_KEY=
# GEMINI_API_KEY=

# Hugging Face connection mode: "deployed" or "local".
# Deployed mode uses the built-in Hugging Face server.
# Defaults to "deployed" when unset.
# HF_REALTIME_CONNECTION_MODE="deployed"

# Direct Hugging Face realtime endpoint for local/LAN backends.
# Accepts either the base URL (`ws://127.0.0.1:8765/v1`) or the full realtime URL
# (`ws://127.0.0.1:8765/v1/realtime`). Used when HF_REALTIME_CONNECTION_MODE=local.
# HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Local vision model (only used with --local-vision CLI flag)
# By default, vision is handled by the selected realtime backend when the camera tool is used
LOCAL_VISION_MODEL=HuggingFaceTB/SmolVLM2-2.2B-Instruct

# Cache for local VLM (only used with --local-vision CLI flag)
HF_HOME=./cache

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not listed in the selected profile's tools.txt.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1


# ─────────────────────────────────────────────────────────────────────────────
# Local Agent backend (BACKEND_PROVIDER="local")
# ─────────────────────────────────────────────────────────────────────────────
# Route A: this app is the body (mic/VAD/STT + TTS/speaker + camera + movement),
# and your own self-hosted, OpenAI-compatible agent is the brain. Point the
# variables below at YOUR services. All default to 127.0.0.1 placeholders and are
# safe/no-op until you set them. Nothing here ships with real endpoints.
#
# The agent brain: any server exposing POST {AGENT_BASE_URL}/chat/completions.
# AGENT_BASE_URL="http://127.0.0.1:8642/v1"
# AGENT_MODEL="local-agent"
# AGENT_API_KEY_ENV="API_SERVER_KEY"     # name of the env var holding the bearer token (optional)
# API_SERVER_KEY=                         # the token itself, if your agent needs auth
#
# Speech-to-text (OpenAI-compatible /audio/transcriptions, or streaming WS).
# AGENT_STT_BASE_URL="http://127.0.0.1:5092/v1"
# AGENT_STT_MODEL="parakeet"
#
# Text-to-speech (OpenAI-compatible /audio/speech; WAV/PCM out).
# AGENT_QWEN_TTS_BASE_URL="http://127.0.0.1:7034/v1"
# AGENT_QWEN_TTS_MODEL="your-tts-model"
# AGENT_QWEN_TTS_VOICE="default"          # pick a voice your TTS server exposes
# AGENT_TTS_SPEED="1.0"                    # default 1.0 (clamped 0.5-2.0); ~0.95 often sounds more natural
# AGENT_OUTPUT_GAIN="0.9"                  # default 0.9: headroom prevents clipping on Reachy's speaker
# AGENT_PLAYBACK_SEGMENT_S="0.5"           # default 0.5 s blocks (clamped 0.02-1.0); ~0.1 can reduce speaker underruns
# AGENT_PLAYBACK_LEAD_S="1.0"              # default 1.0 s of audio allowed in the downstream queue
#
# STT language: default "en". Set another code, or "auto" to let the STT model detect it.
# AGENT_STT_LANGUAGE="en"
#
# Live pipeline monitor (loopback only; shows STT/LLM/TTS text verbatim + tool calls). On by default.
# AGENT_PIPELINE_MONITOR="1"               # default 1; set 0 to disable
# AGENT_PIPELINE_MONITOR_PORT="8766"       # default 8766
# AGENT_PIPELINE_MONITOR_LOG_CONTENT="0"   # default 0: logs carry stage/length/metadata only, not the text
#
# Latency-masking speech. All of these are ON by default (values in brackets); uncomment the
# "0" lines to speak only the real assistant answer (quiet profile).
# AGENT_QUICKTAKE_ENABLED="0"              # [1] short opener while the brain is still silent
# AGENT_GAP_FILL_MAX="0"                   # [2] tail fillers after the opener
# AGENT_TOOL_STATUS_ENABLED="0"            # [1] spoken "One moment, ..." on slow tools (monitor/logs still show them)
# AGENT_LEAD_IN_ENABLED="0"                # [1] auxiliary LLM that writes the opener
#
# Quiet-motion profile: prioritise microphone pickup over expressiveness. Every switch below
# defaults to ON ("1") when unset; uncomment a "0" line to turn that motion off.
# AGENT_IDLE_BREATHING="0"                 # continuous head/antenna breathing while idle
# AGENT_IDLE_ACTIONS="0"                   # random idle dances, emotions, or head turns
# AGENT_SPEECH_WOBBLE="0"                  # daemon head wobble driven by Reachy's own speech
# AGENT_SPEECH_SWAY="0"                    # antenna sway driven by Reachy's own speech
# AGENT_TURN_EMOTES="0"                    # automatic movement after conversational turns
# AGENT_ORIENT_TO_SPEAKER="0"              # head turn when the microphone detects speech
# Always active regardless of the quiet profile (shown with their defaults):
# AGENT_ANTENNA_REST_DEG="10"              # clamped 0-20: slight outward bias avoids servo hunting at zero
# AGENT_THINKING_CUE="1"                   # tiny antenna cue while waiting for the backend
# AGENT_THINKING_CUE_DELAY_S="0.8"
# AGENT_THINKING_CUE_MAX_DEG="2.0"         # intentionally much smaller than expressive motion
# AGENT_THINKING_CUE_HZ="0.18"             # slow, smooth cycle to avoid motor-noise chatter
#
# Optional vision VLM for the one-shot "look" tool (OpenAI-compatible chat + image_url).
# AGENT_VLM_BASE_URL="http://127.0.0.1:3448/v1"
#
# Optional low-latency "lead-in" model that speaks a short bridge while the brain thinks.
# AGENT_LEAD_IN_ENABLED=0
# AGENT_LEAD_IN_BASE_URL="http://127.0.0.1:3447/v1"
#
# Reachy daemon (local robot HTTP API) for audio playback + movement + status.
# AGENT_DAEMON_BASE_URL="http://127.0.0.1:8000"
# REACHY_MINI_HOST="192.168.4.46"         # connect to the daemon over the network (same as --robot-host)
# AGENT_PLATFORM_WS_URL="ws://127.0.0.1:8770/robot/reachy"
# Shared secret sent in the platform "hello" frame; must match the adapter's REACHY_WS_API_KEY.
# Give the key itself, or an absolute file path (the nonempty key variable wins).
# AGENT_PLATFORM_API_KEY_FILE and gateway REACHY_WS_API_KEY_FILE must contain the same secret.
# A 1008 authentication rejection stops reconnects; correct the key and restart the app.
# AGENT_PLATFORM_API_KEY="replace-with-the-same-value-as-REACHY_WS_API_KEY"
# AGENT_PLATFORM_API_KEY_FILE="/path/to/reachy-api-key"
#
# Persona: this fork ships a neutral 'local-agent' profile. Select it, or drop your
# own profile folder into external_content/external_profiles and point at it.
# REACHY_MINI_CUSTOM_PROFILE=local-agent
